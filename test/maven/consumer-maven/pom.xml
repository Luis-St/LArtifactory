<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>net.luis.lartifactory.test</groupId>
	<artifactId>consumer-maven</artifactId>
	<version>1.0.0</version>
	<packaging>jar</packaging>

	<properties>
		<maven.compiler.release>17</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<artifactory.url>http://localhost:8080</artifactory.url>
	</properties>

	<repositories>
		<repository>
			<id>lartifactory-releases</id>
			<url>${artifactory.url}/maven/maven-releases</url>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>
		<repository>
			<id>lartifactory-snapshots</id>
			<url>${artifactory.url}/maven/maven-snapshots</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
				<updatePolicy>always</updatePolicy>
			</snapshots>
		</repository>
	</repositories>

	<dependencies>
		<dependency>
			<groupId>net.luis.lartifactory.test</groupId>
			<artifactId>maven-lib</artifactId>
			<version>1.0.0</version>
		</dependency>
		<dependency>
			<groupId>net.luis.lartifactory.test</groupId>
			<artifactId>gradle-lib</artifactId>
			<version>1.1.0-SNAPSHOT</version>
		</dependency>
	</dependencies>
</project>
