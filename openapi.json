  "components" : {
    "schemas" : {
      "CreateRepositoryRequest" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string"
          },
          "description" : {
            "type" : "string"
          },
          "publicRead" : {
            "type" : "boolean"
          },
          "allowRedeploy" : {
            "type" : "boolean"
          }
        }
      },
      "CreateTokenRequest" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "username" : {
            "type" : "string"
          },
          "level" : {
            "type" : "string"
          },
          "expiresInDays" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "CreateUserRequest" : {
        "type" : "object",
        "properties" : {
          "username" : {
            "type" : "string"
          },
          "password" : {
            "type" : "string"
          },
          "admin" : {
            "type" : "boolean"
          }
        }
      },
      "PermissionRequest" : {
        "type" : "object",
        "properties" : {
          "repository" : {
            "type" : "string"
          },
          "username" : {
            "type" : "string"
          },
          "level" : {
            "type" : "string"
          }
        }
      },
      "UpdateRepositoryRequest" : {
        "type" : "object",
        "properties" : {
          "description" : {
            "type" : "string"
          },
          "publicRead" : {
            "type" : "boolean"
          },
          "allowRedeploy" : {
            "type" : "boolean"
          }
        }
      },
      "UpdateUserRequest" : {
        "type" : "object",
        "properties" : {
          "password" : {
            "type" : "string"
          },
          "admin" : {
            "type" : "boolean"
          }
        }
      },
      "ErrorResponse" : {
        "type" : "object",
        "properties" : {
          "error" : {
            "type" : "string"
          },
          "description" : {
            "type" : "string"
          }
        }
      },
      "FileResponse" : {
        "type" : "object",
        "properties" : {
          "path" : {
            "type" : "string"
          },
          "packageName" : {
            "type" : "string"
          },
          "version" : {
            "type" : "string"
          },
          "size" : {
            "type" : "integer",
            "format" : "int64"
          },
          "sha256" : {
            "type" : "string"
          },
          "sha1" : {
            "type" : "string"
          },
          "md5" : {
            "type" : "string"
          },
          "contentType" : {
            "type" : "string"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "createdBy" : {
            "type" : "string"
          }
        },
        "required" : [ "size" ]
      },
      "HealthResponse" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string"
          },
          "database" : {
            "type" : "string"
          }
        }
      },
      "PackageResponse" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "versions" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/VersionResponse"
            }
          },
          "tags" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "string"
            }
          }
        }
      },
      "VersionResponse" : {
        "type" : "object",
        "properties" : {
          "version" : {
            "type" : "string"
          },
          "yanked" : {
            "type" : "boolean"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "createdBy" : {
            "type" : "string"
          }
        },
        "required" : [ "yanked" ]
      },
      "PermissionResponse" : {
        "type" : "object",
        "properties" : {
          "repository" : {
            "type" : "string"
          },
          "username" : {
            "type" : "string"
          },
          "level" : {
            "type" : "string"
          }
        }
      },
      "PrincipalResponse" : {
        "type" : "object",
        "properties" : {
          "username" : {
            "type" : "string"
          },
          "admin" : {
            "type" : "boolean"
          },
          "tokenLevel" : {
            "type" : "string"
          }
        },
        "required" : [ "admin" ]
      },
      "RepositoryResponse" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string"
          },
          "description" : {
            "type" : "string"
          },
          "publicRead" : {
            "type" : "boolean"
          },
          "allowRedeploy" : {
            "type" : "boolean"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "url" : {
            "type" : "string"
          }
        },
        "required" : [ "publicRead", "allowRedeploy" ]
      },
      "TokenResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "username" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "level" : {
            "type" : "string"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "expiresAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "token" : {
            "type" : "string"
          }
        }
      },
      "UserResponse" : {
        "type" : "object",
        "properties" : {
          "username" : {
            "type" : "string"
          },
          "admin" : {
            "type" : "boolean"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "admin" ]
      }
    }
  }
}