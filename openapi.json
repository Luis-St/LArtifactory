      "patch" : {
        "tags" : [ "Repositories" ],
        "summary" : "Update a repository",
        "operationId" : "updateRepository",
        "parameters" : [ {
          "name" : "name",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateRepositoryRequest"
              }
            }
