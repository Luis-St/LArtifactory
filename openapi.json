      "delete" : {
        "tags" : [ "Repositories" ],
        "summary" : "Delete a repository with all its content",
        "operationId" : "deleteRepository",
        "parameters" : [ {
          "name" : "name",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    },
    "/api/repositories/{name}/files" : {
      "get" : {
        "tags" : [ "Repositories" ],
        "summary" : "List the files of a repository",
        "operationId" : "listFiles",
        "parameters" : [ {
          "name" : "name",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "prefix",
          "in" : "query",
          "description" : "Only list files below this path",
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "offset",
          "in" : "query",
          "description" : "Number of files to skip",
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Maximum number of files (default 1000, at most 5000)",
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/FileResponse"
                  }
                }
              }
            },
            "headers" : {
              "X-Total-Count" : {
                "description" : "Total number of matching files",
                "schema" : {
                  "type" : "integer",
                  "format" : "int64"
                }
              }
            }
          }
        }
      }
    },
    "/api/repositories/{name}/packages" : {
      "get" : {
        "tags" : [ "Repositories" ],
        "summary" : "List the packages and versions of a repository",
        "operationId" : "listPackages",
        "parameters" : [ {
          "name" : "name",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "q",
          "in" : "query",
          "description" : "Filter packages by name",
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "offset",
          "in" : "query",
          "description" : "Number of packages to skip",
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Maximum number of packages (default 100, at most 500)",
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/PackageResponse"
                  }
                }
              }
            },
            "headers" : {
              "X-Total-Count" : {
                "description" : "Total number of matching packages",
                "schema" : {
                  "type" : "integer",
                  "format" : "int64"
                }
              }
            }
          }
        }
      },
      "delete" : {
        "tags" : [ "Repositories" ],
        "summary" : "Delete a package version (or the whole package if no version is given) including its files",
        "operationId" : "deletePackage",
        "parameters" : [ {
          "name" : "name",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "package",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "version",
          "in" : "query",
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    },
    "/api/session" : {
      "post" : {
        "tags" : [ "Users" ],
        "summary" : "Sign in to the web ui with the user password (basic auth), returns a session token for bearer authentication",
        "operationId" : "createSession",
