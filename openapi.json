{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "",
    "version" : ""
  },
  "paths" : {
    "/api/me" : {
      "get" : {
        "tags" : [ "Users" ],
        "summary" : "Get the authenticated user",
        "operationId" : "whoami",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PrincipalResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Unauthorized",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/permissions" : {
      "get" : {
        "tags" : [ "Permissions" ],
        "summary" : "List permissions",
        "operationId" : "listPermissions",
        "parameters" : [ {
          "name" : "repository",
          "in" : "query",
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "username",
          "in" : "query",
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/PermissionResponse"
                  }
                }
              }
            }
          }
        }
      },
      "put" : {
        "tags" : [ "Permissions" ],
        "summary" : "Grant a user an access level (READ, WRITE, DELETE) on a repository, use '*' for all repositories",
        "operationId" : "setPermission",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PermissionRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PermissionResponse"
                }
              }
            }
          }
        }
      },
      "delete" : {
        "tags" : [ "Permissions" ],
        "summary" : "Revoke the permission of a user on a repository",
        "operationId" : "deletePermission",
        "parameters" : [ {
          "name" : "repository",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "username",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    },
    "/api/repositories" : {
      "get" : {
        "tags" : [ "Repositories" ],
        "summary" : "List repositories readable by the caller",
        "operationId" : "listRepositories",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/RepositoryResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "Repositories" ],
        "summary" : "Create a repository",
        "description" : "Types: maven, generic, pypi, npm, nuget, cargo",
        "operationId" : "createRepository",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateRepositoryRequest"
              }
            }
          }
        },
        "responses" : {
          "201" : {
            "description" : "Created",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RepositoryResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Bad Request",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "Conflict",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/repositories/{name}" : {
      "get" : {
        "tags" : [ "Repositories" ],
        "summary" : "Get a repository",
        "operationId" : "getRepository",
        "parameters" : [ {
          "name" : "name",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RepositoryResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "Not Found",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "patch" : {
        "tags" : [ "Repositories" ],
        "summary" : "Update a repository",
        "operationId" : "updateRepository",
        "parameters" : [ {
          "name" : "name",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateRepositoryRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RepositoryResponse"
                }
              }
            }
          }
        }
      },
      "delete" : {
        "tags" : [ "Repositories" ],
        "summary" : "Delete a repository with all its content",
        "operationId" : "deleteRepository",
        "parameters" : [ {
          "name" : "name",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    },
    "/api/repositories/{name}/files" : {
      "get" : {
        "tags" : [ "Repositories" ],
        "summary" : "List the files of a repository",
        "operationId" : "listFiles",
        "parameters" : [ {
          "name" : "name",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "prefix",
          "in" : "query",
          "description" : "Only list files below this path",
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/FileResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/repositories/{name}/packages" : {
      "get" : {
        "tags" : [ "Repositories" ],
        "summary" : "List the packages and versions of a repository",
        "operationId" : "listPackages",
        "parameters" : [ {
          "name" : "name",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "q",
          "in" : "query",
          "description" : "Filter packages by name",
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/PackageResponse"
                  }
                }
              }
            }
          }
        }
      },
      "delete" : {
        "tags" : [ "Repositories" ],
        "summary" : "Delete a package version (or the whole package if no version is given) including its files",
        "operationId" : "deletePackage",
        "parameters" : [ {
          "name" : "name",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "package",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "version",
          "in" : "query",
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    },
    "/api/tokens" : {
      "get" : {
        "tags" : [ "Tokens" ],
        "summary" : "List the tokens of the caller (admins may pass a username)",
        "operationId" : "listTokens",
        "parameters" : [ {
          "name" : "username",
          "in" : "query",
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/TokenResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "Tokens" ],
        "summary" : "Create a token, the secret is only returned once",
        "description" : "Tokens can be used as password (basic auth), bearer token (npm), api key (NuGet) or raw authorization header (Cargo)",
        "operationId" : "createToken",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateTokenRequest"
              }
            }
          }
        },
        "responses" : {
          "201" : {
            "description" : "Created",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/tokens/{id}" : {
      "delete" : {
        "tags" : [ "Tokens" ],
        "summary" : "Revoke a token",
        "operationId" : "deleteToken",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    },
    "/api/users" : {
      "get" : {
        "tags" : [ "Users" ],
        "summary" : "List users",
        "operationId" : "listUsers",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/UserResponse"
                  }
