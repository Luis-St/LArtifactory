{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "LArtifactory",
    "version" : "1.0.0",
    "description" : "Artifact repository management API"
  },
  "paths" : {
    "/api/audit" : {
      "get" : {
        "tags" : [ "Audit" ],
        "summary" : "List audit log entries (newest first), administrators only",
        "operationId" : "listAudit",
        "parameters" : [ {
          "name" : "repository",
          "in" : "query",
          "description" : "Filter by repository",
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "actor",
          "in" : "query",
          "description" : "Filter by the user that performed the action",
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "action",
          "in" : "query",
          "description" : "Filter by action identifier, e.g. repository.create",
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Maximum number of entries (default 100, max 500)",
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "offset",
          "in" : "query",
          "description" : "Number of entries to skip for paging",
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/AuditResponse"
                  }
                }
              }
            }
          },
          "401" : {
            "description" : "Unauthorized",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Forbidden",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
